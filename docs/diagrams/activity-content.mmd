%% Диаграмма деятельности: основной бизнес-процесс (US-1, US-5, US-9, US-10)
flowchart TD
    start((Начало)) --> hasAcc{Есть учётная<br/>запись?}
    hasAcc -- нет --> reg["Зарегистрироваться (US-1)"] --> code["Ввести код из письма"]
    code --> codeOk{Код верный?}
    codeOk -- нет --> code
    codeOk -- да --> home
    hasAcc -- да --> login["Войти (US-2)"] --> home["Главная страница"]

    home --> hasBiz{Есть бизнес?}
    hasBiz -- нет --> createBiz["Создать бизнес (US-5)"] --> choose
    hasBiz -- да --> choose["Выбрать активный бизнес (US-6)"]

    choose --> what{Что нужно?}
    what -- "один пост" --> post["Описание, цель, тон:<br/>генерация поста (US-9)"]
    what -- "план" --> plan["Цель, число идей, срок:<br/>генерация плана (US-10)"]
    what -- "идеи у конкурентов" --> tg["Анализ канала (US-7),<br/>выбор постов, генерация (US-8)"]

    post --> edit["Отредактировать результат"]
    tg --> edit
    plan --> editPlan["Изменить / удалить / добавить идеи"] --> savePlan["Сохранить план"]
    edit --> copy["Скопировать и опубликовать<br/>в соцсети (вне системы)"]
    savePlan --> copy
    copy --> more{Ещё контент?}
    more -- да --> what
    more -- нет --> stop((Конец))
