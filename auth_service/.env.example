# user/password must match POSTGRES_AUTH_* in the root .env
APP_CONFIG__DB__URL=postgresql+psycopg2://micro_cms_user:change_me@postgres_auth:5432/micro_cms_auth_db

# SECRET_KEY must be the same in auth_service, business_service and content_service
APP_CONFIG__JWT__SECRET_KEY=change_me
APP_CONFIG__JWT__ALGORITHM=HS256
APP_CONFIG__JWT__ACCESS_TOKEN_EXP_MINUTES=30
APP_CONFIG__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

APP_CONFIG__RABBIT__HOST=rabbitmq
APP_CONFIG__RABBIT__PORT=5672

APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
