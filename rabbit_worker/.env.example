RABBITMQ_CONFIG__RABBIT__HOST=rabbitmq
RABBITMQ_CONFIG__RABBIT__PORT=5672

# For Gmail use an app password: https://myaccount.google.com/apppasswords
RABBITMQ_CONFIG__SMTP__SERVER=smtp.gmail.com
RABBITMQ_CONFIG__SMTP__PORT=587
RABBITMQ_CONFIG__SMTP__USER=your_email@gmail.com
RABBITMQ_CONFIG__SMTP__PASSWORD=your_app_password
