# Единый файл окружения для docker compose.
# Скопируйте его в .env: значения по умолчанию запускают проект в демо-режиме
# (без OpenRouter, Telegram и SMTP). Для реального режима см. раздел «Внешние сервисы» в README.

# ===== Порты на хост-машине =====
FRONTEND_PORT=3000
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=50051
CONTENT_SERVICE_PORT=50052
BUSINESS_SERVICE_PORT=50053
POSTGRES_AUTH_PORT=5432
POSTGRES_CONTENT_PORT=5433
POSTGRES_BUSINESS_PORT=5434
RABBITMQ_AMQP_PORT=5672
RABBITMQ_WEB_PORT=15672
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Базы данных (строка подключения для каждого сервиса собирается в docker-compose.yml) =====
POSTGRES_AUTH_USER=micro_cms_user
POSTGRES_AUTH_PASSWORD=change_me
POSTGRES_AUTH_DB=micro_cms_auth_db

POSTGRES_CONTENT_USER=micro_cms_user
POSTGRES_CONTENT_PASSWORD=change_me
POSTGRES_CONTENT_DB=micro_cms_content_db

POSTGRES_BUSINESS_USER=micro_cms_user
POSTGRES_BUSINESS_PASSWORD=change_me
POSTGRES_BUSINESS_DB=micro_cms_business_db

# ===== MinIO (S3) =====
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio

# ===== Общие настройки Python-сервисов (префикс APP_CONFIG__) =====
# SECRET_KEY должен совпадать во всех сервисах — поэтому он один
APP_CONFIG__JWT__SECRET_KEY=change_me_jwt_secret
APP_CONFIG__JWT__ALGORITHM=HS256
APP_CONFIG__JWT__ACCESS_TOKEN_EXP_MINUTES=30
APP_CONFIG__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

APP_CONFIG__RABBIT__HOST=rabbitmq
APP_CONFIG__RABBIT__PORT=5672

APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0

# ACCESS_KEY/SECRET_KEY = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
APP_CONFIG__MINIO__ENDPOINT=minio:9000
APP_CONFIG__MINIO__ACCESS_KEY=admin
APP_CONFIG__MINIO__SECRET_KEY=change_me_minio
APP_CONFIG__MINIO__SECURE=false
APP_CONFIG__MINIO__REGION=us-east-1
APP_CONFIG__MINIO__MAX_FILE_SIZE=104857600
APP_CONFIG__MINIO__PUBLIC_URL=http://minio:9000

# ===== Внешние сервисы =====
# Демо-режим: true — генерация через MockLLMClient, без ключа OpenRouter
APP_CONFIG__ML__MOCK=true
# https://openrouter.ai/keys
APP_CONFIG__ML__OPENROUTER_API_KEY=
APP_CONFIG__ML__OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Демо-режим: true — тестовые посты вместо Telegram API
APP_CONFIG__TELEGRAM__MOCK=true
# https://my.telegram.org -> API development tools
APP_CONFIG__TELEGRAM__API_ID=0
APP_CONFIG__TELEGRAM__API_HASH=

# ===== Почтовый воркер (префикс RABBITMQ_CONFIG__) =====
RABBITMQ_CONFIG__RABBIT__HOST=rabbitmq
RABBITMQ_CONFIG__RABBIT__PORT=5672
# console — код подтверждения пишется в лог rabbit_worker; smtp — реальная отправка
RABBITMQ_CONFIG__SMTP__MODE=console
# Для Gmail нужен пароль приложения: https://myaccount.google.com/apppasswords
RABBITMQ_CONFIG__SMTP__SERVER=smtp.gmail.com
RABBITMQ_CONFIG__SMTP__PORT=587
RABBITMQ_CONFIG__SMTP__USER=
RABBITMQ_CONFIG__SMTP__PASSWORD=
