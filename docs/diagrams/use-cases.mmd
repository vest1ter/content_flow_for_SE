%% Диаграмма вариантов использования (FR-1…FR-10). В Mermaid нет нотации UML use case,
%% поэтому варианты использования изображены овалами внутри границы системы.
flowchart LR
    user(["Пользователь"])

    subgraph sys["ContentFlow AI"]
        direction TB
        uc1(["Зарегистрироваться и подтвердить email<br/>FR-1"])
        uc3(["Восстановить пароль<br/>FR-3"])
        uc2(["Войти и продлить сессию<br/>FR-2"])
        uc4(["Управлять бизнесами<br/>FR-4"])
        uc5(["Переключить активный бизнес<br/>FR-5"])
        uc10(["Просмотреть историю контента<br/>FR-10"])
        uc8(["Сгенерировать пост для бизнеса<br/>FR-8"])
        uc9(["Сгенерировать и отредактировать контент-план<br/>FR-9"])
        uc7(["Сгенерировать пост по популярным<br/>FR-7"])
        uc6(["Найти популярные посты канала<br/>FR-6"])
    end

    subgraph ext["Внешние системы"]
        direction TB
        mail(["Почтовый сервер"])
        llm(["OpenRouter (LLM)"])
        tg(["Telegram API"])
    end

    user --- uc1 & uc3 & uc2 & uc4 & uc5 & uc10 & uc8 & uc9 & uc7 & uc6
    uc1 --- mail
    uc3 --- mail
    uc8 --- llm
    uc9 --- llm
    uc7 --- llm
    uc6 --- tg
    uc7 -. "include" .-> uc6
