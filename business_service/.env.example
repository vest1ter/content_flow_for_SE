# user/password must match POSTGRES_BUSINESS_* in the root .env
APP_CONFIG__DB__URL=postgresql+psycopg2://micro_cms_user:change_me@postgres_business:5432/micro_cms_business_db

# SECRET_KEY must be the same in auth_service, business_service and content_service
APP_CONFIG__JWT__SECRET_KEY=change_me
APP_CONFIG__JWT__ALGORITHM=HS256
APP_CONFIG__JWT__ACCESS_TOKEN_EXP_MINUTES=30
APP_CONFIG__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# ACCESS_KEY/SECRET_KEY = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD from the root .env
APP_CONFIG__MINIO__ENDPOINT=minio:9000
APP_CONFIG__MINIO__ACCESS_KEY=admin
APP_CONFIG__MINIO__SECRET_KEY=change_me
APP_CONFIG__MINIO__SECURE=false
APP_CONFIG__MINIO__REGION=us-east-1
APP_CONFIG__MINIO__MAX_FILE_SIZE=104857600
APP_CONFIG__MINIO__PUBLIC_URL=http://minio:9000
